{
  "name": "react-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "start": "turbo run start",
    "sync:playground": "turbo run sync:playground --filter=@react-playground/web"
  },
  "devDependencies": {
    "bun": "1.4.0",
    "typescript": "^5.9.2",
    "turbo": "^2.10.11"
  }
}
