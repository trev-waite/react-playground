{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "import"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "react/exhaustive-effect-dependencies": "off",
    "react/jsx-key": "error",
    "react/jsx-no-target-blank": "error",
    "react/button-has-type": "error",
    "react/no-danger": "error",
    "jsx-a11y/prefer-tag-over-role": "off",

    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-is-valid": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-proptypes": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/role-has-required-aria-props": "error",
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/no-noninteractive-element-interactions": "error",
    "jsx-a11y/no-noninteractive-element-to-interactive-role": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/no-autofocus": "error",
    "jsx-a11y/tabindex-no-positive": "error",
    "jsx-a11y/heading-has-content": "error",
    "jsx-a11y/iframe-has-title": "error",

    "eslint/eqeqeq": ["error", "always", { "null": "ignore" }],
    "eslint/no-console": ["error", { "allow": ["warn", "error"] }],
    "eslint/no-debugger": "error",
    "eslint/no-unused-vars": "error",
    "eslint/no-var": "error",
    "eslint/prefer-const": "error"
  },
  "overrides": [
    {
      "files": ["apps/api/**", "apps/web/scripts/**", "apps/web/vite/**"],
      "rules": { "eslint/no-console": "off" }
    },
    {
      "files": [
        "apps/web/src/app/deck/CardDeck.tsx",
        "apps/web/src/app/deck/usePaging.ts",
        "apps/web/src/experimental/DockSlider.tsx",
        "apps/web/src/experimental/ExperimentalPage.tsx",
        "apps/web/src/experimental/IdeaProjects.tsx",
        "apps/web/src/experimental/IdeaWorkbench.tsx",
        "apps/web/src/experimental/useIdeaSync.ts",
        "apps/web/src/experimental/ideas/BlobPet/source.tsx",
        "apps/web/src/experimental/ideas/LightDispersion/source.tsx",
        "apps/web/src/experimental/ideas/SpacingTidy/source.tsx",
        "apps/web/src/experimental/ideas/TreeFlipbook/source.tsx",
        "apps/web/src/gpu/useGpu.ts",
        "apps/web/src/live/buttons/PrimaryButton/PrimaryButton.tsx",
        "apps/web/src/live/shaders/LightDispersion/LightDispersion.tsx",
        "apps/web/src/live/shells/ConfigurableShell/ExamplePreview.tsx",
        "apps/web/src/live/svgs/BlobPet/BlobPet.tsx",
        "apps/web/src/live/tools/SpacingTidy/SpacingTidy.tsx",
        "apps/web/src/studio/ViewController.tsx"
      ],
      "rules": {
        "react/refs": "off",
        "react/immutability": "off",
        "react/set-state-in-effect": "off",
        "react/static-components": "off",
        "react-hooks/exhaustive-deps": "off",
        "jsx-a11y/label-has-associated-control": "off",
        "jsx-a11y/no-noninteractive-element-to-interactive-role": "off",
        "jsx-a11y/role-supports-aria-props": "off"
      }
    }
  ],
  "ignorePatterns": ["**/dist/**", "**/node_modules/**"]
}
