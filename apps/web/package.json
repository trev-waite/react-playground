{
  "name": "@react-playground/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:playground": "bun scripts/sync-playground.ts",
    "dev": "bun scripts/dev.ts",
    "build": "bun scripts/sync-playground.ts && bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
    "start": "NODE_ENV=production bun src/index.ts",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@react-playground/api": "workspace:*",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5"
  }
}
