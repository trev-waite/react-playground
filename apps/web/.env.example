# Vite dev forwards /api here.
API_PROXY_TARGET=http://localhost:3001
# Optional: bypass the proxy for a separately hosted API (requires CORS).
# VITE_API_URL=https://your-api.example.com
# Show the light/dark theme button. Off by default: the site follows the system theme.
# VITE_THEME_TOGGLE=on
# Public origin of the deployed Live app, for absolute link-preview URLs (og:image).
# SITE_URL=https://studio.trevorwaite.com
